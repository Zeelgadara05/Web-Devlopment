# StudentHub Portal - Apache configuration
# ----------------------------------------
# Every root-level .html page is served through php/page_gate.php so the portal
# can require a login before any page is shown. Student self-registration and
# the login page stay public.

DirectoryIndex index.php index.html

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Public pages: never gated.
    RewriteRule ^(login|Registration)\.html$ - [L,NC]

    # Any other root-level HTML page goes through the session gate.
    RewriteRule ^([A-Za-z0-9_-]+\.html)$ php/page_gate.php?page=$1 [L,QSA,NC]
</IfModule>

# Development cache settings:
# make sure the browser always gets the latest HTML, JS, CSS and JSON files.
<IfModule mod_headers.c>
    <FilesMatch "\.(html|js|css|json)$">
        Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
        Header set Pragma "no-cache"
        Header set Expires "Thu, 01 Jan 1970 00:00:00 GMT"
    </FilesMatch>

    # Baseline hardening for the two HTML pages served without the PHP gate.
    <FilesMatch "\.html$">
        Header always set X-Content-Type-Options "nosniff"
        Header always set X-Frame-Options "SAMEORIGIN"
        Header always set Referrer-Policy "strict-origin-when-cross-origin"
    </FilesMatch>
</IfModule>
